# Copy to .env.local and fill in. For local dev, values come from `npx supabase status -o env`.

# Frontend (bundled into the browser build — public values only)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Scripts and integration tests (never bundled; bypasses Row Level Security)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
